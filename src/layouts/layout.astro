---
import { Sidebar } from '../components/Sidebar';
import { ClientRouter } from 'astro:transitions';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="JosliBlue portfolio" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>JosliBlue | {title}</title>

        <meta property="og:title" content="JosliBlue Dev" />
        <meta property="og:description" content="My portfolio web" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://josliblue.netlify.app/" />

        <link rel="canonical" href="https://josliblue.netlify.app" />

        <ClientRouter />
    </head>

    <body class="bg-bg-primary text-text-primary min-h-screen">
        <Sidebar client:load currentPath={Astro.url.pathname} />

        <main class="md:ml-64 min-h-screen pt-16 md:pt-0">
            <div class="max-w-5xl mx-auto p-6 md:p-12 lg:p-16">

                <slot />
                
            </div>
        </main>

    </body>
</html>
