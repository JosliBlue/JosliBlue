---
import Layout from '../layouts/layout.astro';
import { Endpoint } from '../components/Endpoint';
import { ContactForm } from '../components/ContactForm';
---

<Layout title="Contact">
    <div class="space-y-6">
        <div>
            <h1 class="text-4xl font-extrabold text-text-primary mb-5">Get in Touch</h1>
            <p class="prose prose-invert max-w-none text-text-secondary text-lg">
                Have a question or want to work together? Feel free to reach out!
                I'll get back to you as soon as possible.
            </p>
        </div>

        <Endpoint
            client:load
            method="POST"
            path="/contact"
            style={{ viewTransitionName: 'contact-endpoint' } as any}
        >
            <div class="space-y-4">
                <p class="text-sm text-text-secondary">
                    Send me a message and I'll respond to your email address.
                </p>
                <div>
                    <ContactForm client:load />
                </div>
            </div>
        </Endpoint>
    </div>
</Layout>
