---
import Layout from '../layouts/layout.astro';
import { Endpoint } from '../components/Endpoint';
import { ProjectsLoader } from '../components/ProjectsLoader';
---

<Layout title="Projects">
    <div class="space-y-6">
        <div>
            <h1 class="text-4xl font-extrabold text-text-primary mb-4">My featured projects</h1>
            <p class="prose prose-invert max-w-none text-text-secondary text-lg">
                In this section you will find my main works to date.
            </p>
        </div>

        <Endpoint
            client:load
            method="GET"
            path="/featured-projects"
            style={{ viewTransitionName: 'main-endpoint' } as any}
        >
            <ProjectsLoader client:load />
        </Endpoint>
    </div>
</Layout>
