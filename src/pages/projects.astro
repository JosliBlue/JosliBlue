---
import Layout from '../layouts/layout.astro';
import { Endpoint } from '../components/Endpoint';
import { ProjectsLoader } from '../components/ProjectsLoader';
import { CodeBlock } from '../components/CodeBlock';

const moreData = {
    message: "Redirecting to GitHub repositories...",
    url: "https://github.com/JosliBlue?tab=repositories",
};
---

<Layout title="Projects">
    <div class="space-y-6">
        <div>
            <h1 class="text-4xl font-extrabold text-text-primary mb-4">My featured projects</h1>
            <p class="prose prose-invert max-w-none text-text-secondary text-lg">
                In this section you will find my main works to date.
            </p>
        </div>

        <Endpoint
            client:load
            method="GET"
            path="/featured-projects"
            style={{ viewTransitionName: 'main-endpoint' } as any}
        >
            <ProjectsLoader client:load />
        </Endpoint>

        <Endpoint
            client:load
            method="GET"
            path="/more-repositories"
            style={{ viewTransitionName: 'second-endpoint' } as any}
        >

            
            <div class="space-y-4">
                <p class="text-sm text-text-secondary">Want to see more of my work? Check out all my repositories on GitHub</p>
                <div>
                    <CodeBlock client:load code={JSON.stringify(moreData, null, 2)} statusCode={200} />
                </div>
            </div>
        </Endpoint>
    </div>
</Layout>
